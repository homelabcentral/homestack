# METADATA --- START
# DO NOT CHANGE THE BELOW
Description=Host related variables that will be used across the docker-compose files. These variables are specific to the host machine and can be used to configure various aspects of the containers, such as user permissions, and volume mounts. Make sure to update these variables according to your host machine's configuration before using the docker-compose files.
Required=true
# METADATA --- END

# User related

USER_NAME= # type=string | compute=username | prompt=Enter the username of the user | description=The username of the user. This defaults from your initialized host preferences. | instruction=Keep this the same as your username.
UID= # type=int | compute=uid | prompt=Enter the user ID of the user | description=The user id of the user. This defaults from your initialized host preferences.
GID= # type=int | compute=gid | prompt=Enter the group ID of the user | description=The group id of the user. This defaults from your initialized host preferences.
GID_DOCKER= # type=int | compute=docker_gid | prompt=Enter the group ID of the docker group | description=The group id of the docker group. This defaults from your initialized host preferences when available.

HOST_NAME= # type=string | prompt=Enter the hostname of the machine | description=The hostname of the machine. eg. `hostname` on linux
DOMAIN= # type=string | prompt=Enter the name of your domain | description=The name of your domain, or website. eg. example.com
SUB_DOMAIN= # type=string | prompt=Enter the name of your subdomain. This will be used to get to the website. For example: https://app.subdomain.example.com | description=The name of your subdomain. It will be used to access any web based apps. | immutable=false

# Timezone related

TZ= # type=string | prompt=Enter the timezone of the machine | description=The timezone of the machine. eg. `timedatectl | grep "Time zone" | awk '{print $3}'` on linux. Or visit https://en.wikipedia.org/wiki/List_of_tz_database_time_zones to find yours. | compute=timezone
LOCALTIME= # type=string | prompt=Enter the path to the localtime file | description=The path to the localtime file on the host machine. This file is used to set the timezone inside the containers. It is usually located at /etc/localtime on most Linux distributions. | immutable=true
DOCKER_SOCKET= # type=string | prompt=Enter the path to the docker socket | description=The path to the docker socket on the host machine. This file is used to allow the containers to communicate with the docker daemon on the host machine. It is usually located at /var/run/docker.sock on most Linux distributions. | immutable=true

DIR_HOMESTACK= # recommended= | type=path | prompt=Enter the directory where you want to store your homestack related files | description=Make sure you can write to that location/directory | immutable=false
