# METADATA --- START
# DO NOT CHANGE THE BELOW
Description=Email related environment variables. These variables are used to configure the email settings for the containers, such as SMTP server address, credentials, and ports. Make sure to update these variables according to your email service provider's configuration before using the docker-compose files.
Required=true
# METADATA --- END

SMTP_SERVER= # recommended= | type=string | prompt=Enter the SMTP server address, description=This is the address of the SMTP server provided by your email service provider. It is used to send emails from the containers. | immutable=false
SMTP_PORT= # recommended=587 | type=port | prompt=Enter the SMTP server port, description=This is the port number used by the SMTP server for sending emails. Common ports are 587 for TLS, 465 for SSL, and 25 for non-secure connections. | immutable=false
SMTP_USERNAME= # recommended= | type=string | prompt=Enter the SMTP server username, description=This is the username for authenticating with the SMTP server. It is usually the email address or a specific username provided by your email service provider. | immutable=false
SMTP_PASSWORD= # recommended= | type=password | prompt=Enter the SMTP server password, description=This is the password for authenticating with the SMTP server. It is usually provided by your email service provider. | immutable=false
SMTP_SECURITY= # recommended=starttls | type=string | prompt=Enter the SMTP security protocol, description=This is the security protocol used for connecting to the SMTP server. Common options are "tls" for STARTTLS, "ssl" for SSL/TLS, and "none" for non-secure connections. | choices=[tls, ssl, none] | immutable=false
SMTP_FROM_NAME= # recommended= | type=string | prompt=Enter the name to be displayed in the "From" field of the emails, description=This is the name that will be displayed in the "From" field of the emails sent from the containers. It can be your name, your company name, or any other name you want to use. | immutable=false
SMTP_FROM_EMAIL= # recommended= | type=string | prompt=Enter the email address to be used in the "From" field of the emails, description=This is the email address that will be used in the "From" field of the emails sent from the containers. It should be a valid email address that is associated with the SMTP server you are using. | immutable=false
SMTP_EMBED_IMAGES= # recommended=true | type=string | prompt=Do you want to embed images in the emails sent from the containers?, description=This option determines whether images included in the emails sent from the containers will be embedded directly in the email or linked externally. Embedding images can help ensure they are displayed correctly in email clients, but it may increase the size of the emails. | immutable=false
