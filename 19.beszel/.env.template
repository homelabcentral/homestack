# BESZEL_AGENT_TOKEN= # recommended= | type=string | prompt=Enter a random token for the Beszel agent to authenticate with the Beszel server. You can generate a random token using `openssl rand -hex 16` | immutable=false
# BESZEL_AGENT_KEY= # recommended= | type=string | prompt=Enter a random key for the Beszel agent to authenticate with the Beszel server. You can generate a random key using `openssl rand -hex 32` | immutable=false

BZ_BESZEL_PORT_CONFIG= # recommended=traefik | type=string | prompt=Select on which network interfaces the service should be exposed | choices=[traefik (description=Only expose through traefik, default=true), all (description=Bind to all interfaces on the host, allowing access through both the host IP and traefik), localhost (description=Expose port to localhost, only accesible from this computer and not any other computers on the network and through traefik), tailscale (description=Bind  to the Tailscale IP only, restricting access to devices connected through Tailscale and through traefik)] | immutable=false
