RAM_MIN_LW_LINKWARDEN= # recommended=16M | type=memory | prompt=Enter the minimum RAM limit for linkwarden | instruction=The minimum RAM limit for linkwarden. | immutable=true
RAM_MAX_LW_LINKWARDEN= # recommended=1G | type=memory | prompt=Enter the maximum RAM limit for linkwarden | instruction=The maximum RAM limit for linkwarden. 1G is a good option. Choose wisely if you are on VPS. | immutable=false


