MEILI_MASTER_KEY= # recommended=None | type=passphrase(32) | prompt=Enter the master key for MeiliSearch | instruction=Just a random string of minimum length of 32 characters. Leave blank to auto-generate a secure value. You don't need to remember or save this. Open another terminal and use this command `openssl rand -base64 32` to generate one. or just face plant your keyboard. DO NOT SHARE IT PUBLICLY. | immutable=false

