STACK_LW_LINKWARDEN= # recommended=linkwarden | immutable=true

DOCKER_IMAGE_LW_LINKWARDEN= # recommended=ghcr.io/linkwarden/linkwarden:latest | type=string | prompt=Select the docker image for linkwarden | choices=[ghcr.io/linkwarden/linkwarden:latest (default=true, description=linkwarden docker image hosted on github)] | immutable=true
CONTAINER_NAME_LW_LINKWARDEN= # recommended=linkwarden | type=string | prompt=Enter the container name for linkwarden | instruction=The container name for linkwarden. This is used for identifying the container within the Docker environment and can be set to any value, but it is recommended to set it to the same value as the hostname and application name for consistency and ease of identification. | immutable=true
HOST_NAME_LW_LINKWARDEN= # recommended=linkwarden | type=string | prompt=Enter the hostname for linkwarden | instruction=The hostname for linkwarden. This is used for internal communication between containers and can be set to any value, but it is recommended to set it to the same value as the container name for consistency and ease of identification. | immutable=true
APP_NAME_LW_LINKWARDEN= # recommended=linkwarden | type=string | prompt=Enter the application name for linkwarden | instruction=The application name for linkwarden. This is used for the URL of your app. for example, https://linkwarden.subdomain.domain.com | immutable=false
RESTART_LW_LINKWARDEN= # recommended=unless-stopped | type=string | prompt=Select the restart policy for linkwarden | choices=[no, always (default=true), on-failure, unless-stopped] | immutable=false

DOCKER_IMAGE_LW_POSTGRES= # recommended=postgres:16-alpine | immutable=true | instruction=Docker image of postgres that is used by linkwarden
CONTAINER_NAME_LW_POSTGRES= # recommended=linkwarden-postgres | immutable=true | instruction=Container name for the postgres container that is used by linkwarden

