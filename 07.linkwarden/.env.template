POSTGRES_PASSWORD= # recommended=super-secret-password | type=password | prompt=Enter the PostgreSQL password | instruction=The password for the PostgreSQL database used by linkwarden. You don't have to remember or save this. | immutable=false
POSTGRES_DB= # recommended=linkwarden | type=string | prompt=Enter the PostgreSQL database name | instruction=The name of the PostgreSQL database used by linkwarden. | immutable=true

