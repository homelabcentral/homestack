IP_LW_LINKWARDEN= # recommended=172.16.0.8 | type=ip | prompt=Enter the IP address for linkwarden | instruction=The IP address for linkwarden. This is used for internal communication between containers and can be set to any value, but it is recommended to set it to the same value as the container name for consistency and ease of identification. | immutable=false
PORT_LW_LINKWARDEN_EXTERNAL= # recommended=3003 | type=port | prompt=Enter the external port for linkwarden | description=The external port for linkwarden. This is the port that is exposed on the host machine and can be used to access the linkwarden application from outside the Docker network. It can be set to any value, but it is recommended to set it to a common port for web applications (e.g., 3003) for consistency and ease of use. | immutable=true
PORT_LW_LINKWARDEN_INTERNAL= # recommended=3000 | immutable=true

DIR_NAME_LW_LINKWARDEN= # recommended=linkwarden | type=string | prompt=Enter the directory name to save the data of linkwarden | description=The directory name to save the data of linkwarden. This is used for persisting data and can be set to any value, but it is recommended to set it to the same value as the container name for consistency and ease of identification. | immutable=true

