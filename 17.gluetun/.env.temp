DIR_ARR=arr-vpn # recommended=arr-vpn | type=string | prompt=Enter the directory name for the Arr stack, description=The directory name for the Arr stack. This will be used to create a subdirectory under the DIR_COMPOSE directory where the docker-compose.yml file for this stack will be located. eg. arr-vpn | immutable=true

DIR_DOWNLOADS=/home/smit/Downloads # recommended= | type=path | prompt=Enter the directory where you want to store your downloads for the Arr stack | immutable=false

DIR_MEDIA=/home/smit/Media # recommended= | type=path | prompt=Enter the directory where you want to store your media files OR where they are already stored. For example. /mnt/media or /home/user/media. Inside which there will be TV, Movies and Music folders. | immutable=false

GT_GLUETUN_PORT_CONFIG=traefik # recommended=traefik | type=string | prompt=Select on which network interfaces the service should be exposed | choices=[traefik (description=Only expose through traefik, default=true), all (description=Bind to all interfaces on the host, allowing access through both the host IP and traefik), localhost (description=Expose port to localhost, only accesible from this computer and not any other computers on the network and through traefik), tailscale (description=Bind  to the Tailscale IP only, restricting access to devices connected through Tailscale and through traefik)] | immutable=false