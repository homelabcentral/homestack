# METADATA --- START
# DO NOT CHANGE THE BELOW
Description=Environment variables for Arr stack with gluetun VPN container. This stack includes qBittorrent, Deluge, Oversearr, Sonarr, Radarr, Metube, Flaresolverr, Firefox, Speedtest and Requestrr. The gluetun container is used to route all traffic from the other containers through the VPN.
Required=true
# METADATA --- END

STACK_GT_GLUETUN=gluetun # recommended=gluetun | immutable=true

DOCKER_IMAGE_GT_GLUETUN=qmcgaw/gluetun # recommended=qmcgaw/gluetun | immutable=true
CONTAINER_NAME_GT_GLUETUN=gluetun # recommended=gluetun | immutable=true
HOST_NAME_GT_GLUETUN=gluetun # recommended=gluetun | immutable=true
RESTART_GT_GLUETUN=unless-stopped # recommended=unless-stopped | type=string | prompt=restart policy for the gluetun container. | choices=[no, always, on-failure, unless-stopped] | immutable=false
APP_NAME_GT_GLUETUN=gluetun # recommended=gluetun | type=string | instruction=application name for monitoring and logging purposes. | immutable=true

