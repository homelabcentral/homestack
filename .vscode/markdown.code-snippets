{
    "Project Markdown Frontmatter Block": {
        "scope": "markdown",
        "prefix": "frontmatter",
        "description": "Insert Readme Frontmatter for project",
        "body": [
            "---",
            "author: ${1:Author}",
            "project_name: ${2:Project Name}",
            "project_description: ${3:Project Description}",
            "project_source: ${4:Project Source}",
            "project_website: ${5:Project Website}",
            "project_docs: ${6:Project Docs}",
            "project_status: ${7:Project Status}",
            "stable_images:",
            "  - ${8:Stable Image 1}",
            "  - ${9:Stable Image 2}",
            "stable_versions:",
            "  - ${10:Stable Version 1}",
            "latest_images:",
            "  - ${11:Latest Image 1}",
            "  - ${12:Latest Image 2}",
            "latest_versions:",
            "  - ${13:Latest Version 1}",
            "warning: ${14:none}",
            "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
            "last_updated: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
            "required_env_files:",
            "  - ${15:host.env}",
            "  - ${16:network.env}",
            "config_files:",
            "  - config_file:",
            "      path: ${17:dir/file1.yml}",
            "      immutable: ${18:|true,false|}",
            "      uid: ${19:UID}",
            "      gid: ${20:GID}",
            "      permissions: ${21:644}",
            "  - config_file:",
            "      path: ${22:dir/file2.yml}",
            "      immutable: ${23:|true,false|}",
            "      keys:",
            "        ${24:key1: value1}",
            "        ${25:key2: value2}",
            "pre_install_steps:",
            "  - step:",
            "      number: ${26:1}",
            "      description: ${27:Description of step 1}",
            "      todo: ${28:Todo for step 1}",
            "post_install_steps:",
            "  - step:",
            "      description: ${29:Description of post-install step 1}",
            "      todo: ${30:Todo for post-install step 1}",
            "post_setup_steps:",
            "  - step:",
            "      number: ${31:1}",
            "      description: ${32:Description for post setup}",
            "      todo: ${33:Todo for post setup steps}",
            "supported_architecture:",
            "  - ${34:amd64}",
            "  - ${35:x86}",
            "  - ${36:arm64}",
            "ready_to_deploy: ${37:|true,false|}",
            "---"
        ]
  },

  "Step Markdown Block": {
        "scope": "yaml",
        "prefix": "step",
        "description": "Insert a step block for project documentation",
        "body": [
            "- step:",
            "    number: ${1:1}",
            "    description: ${2:Description of the step}",
            "    todo: ${3:Todo for the step}",
            "    required: ${4:|true,false|}"
        ]
 },

 "Config File Block": {
        "scope": "yaml",
        "prefix": "config-file",
        "description": "Insert a config file block for project documentation",
        "body": [
            "config_files:",
            "  - config_file:",
            "      path: ${1:ports.yml}",
            "      immutable: ${2:|true,false|}",
            "  - config_file:",
            "      path: ${3:dashboard.yml}",
            "      immutable: ${4:|true,false|}"
        ]
 },

  "Traefik Labels Block": {
        "scope": "yaml",
        "prefix": "traefik-labels",
        "description": "Insert Traefik labels with mirrored placeholders",
        "body": [
            "labels:",
            "  - \"traefik.enable=true\"",
            "  - \"traefik.http.routers.\\${APP_NAME_${1:MT_METUBE}:-${2}}.entrypoints=http\"",
            "  - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}.rule=Host(`\\${APP_NAME_${1}:-${2}}.\\${HOST_NAME}.\\${DOMAIN}`)\"",
            "  - \"traefik.http.middlewares.\\${APP_NAME_${1}:-${2}}-https-redirect.redirectscheme.scheme=https\"",
            "  - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}.middlewares=\\${APP_NAME_${1}:-${2}}-https-redirect\"",
            "  - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.entrypoints=https\"",
            "  - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.rule=Host(`\\${APP_NAME_${1}:-${2}}.\\${HOST_NAME}.\\${DOMAIN}`)\"",
            "  - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.tls=true\"",
            "  - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.service=\\${APP_NAME_${1}:-${2}}\"",
            "  - \"traefik.http.services.\\${APP_NAME_${1}:-${2}}.loadbalancer.server.port=\\${PORT_${1}_INTERNAL:-${3}}\"",
            "  - \"traefik.docker.network=${4:traefiknet}\""
        ]
 }  
}