{
    "Add port config for a service" : {
        "scope": "env,.env",
        "prefix": "add-port-config",
        "description": "Adds port config for a service for docker compose defined in ports.yml",
        "body": [
            "${1:SS_SERVICE}_PORT_CONFIG=traefik # recommended=traefik | type=string | prompt=elect on which network interfaces the service should be exposed | choices=[traefik (description=Only expose through traefik, default=true), all (description=Bind to all interfaces on the host, allowing access through both the host IP and traefik), localhost (description=Expose port to localhost, only accesible from this computer and not any other computers on the network and through traefik), tailscale (description=Bind  to the Tailscale IP only, restricting access to devices connected through Tailscale and through traefik)] | immutable=false"
        ]
    }
}