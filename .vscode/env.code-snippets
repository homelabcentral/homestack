{
    "Add port config for a service" : {
        "scope": "dotenv",
        "prefix": "add-port-config",
        "description": "Adds port config for a service for docker compose defined in ports.yml",
        "body": [
            "${1:SS_SERVICE}_PORT_CONFIG=traefik # recommended=traefik | type=string | prompt=Select on which network interfaces the service should be exposed | choices=[traefik (description=Only expose through traefik, default=true), all (description=Bind to all interfaces on the host, allowing access through both the host IP and traefik), localhost (description=Expose port to localhost, only accesible from this computer and not any other computers on the network and through traefik), tailscale (description=Bind  to the Tailscale IP only, restricting access to devices connected through Tailscale and through traefik)] | immutable=false"
        ]
    },
    ".env file template" : {
        "scope": "dotenv",
        "prefix": "env-template",
        "description": "Add a boilerplate .env template",
        "body": [
            "# METADATA --- START",
            "# DO NOT CHANGE THE BELOW",
            "Description=",
            "Required=true",
            "# METADATA --- END",
            "",
            "DOCKER_IMAGE_${1:SS_SERVICE}= # recommended= | type=string | immutable=true",
            "CONTAINER_NAME_${1:SS_SERVICE}=${2:SERVICE} # recommended=${2:SERVICE} | type=string | immutable=true",
            "HOST_NAME_${1:SS_SERVICE}=${2:SERVICE} # recommended=${2:SERVICE} | type=string | immutable=true",
            "RESTART_${1:SS_SERVICE}=unless-stopped # recommended=unless-stopped | type=string | prompt=Choose a restart policy | choices=[no (description=Do not automatically restart the container), on-failure (description=Restart only if the container exits with a non-zero exit code), unless-stopped (description=Always restart the container unless it is explicitly stopped), always (description=Always restart the container regardless of the exit status)] | immutable=false",
            "APP_NAME_${1:SS_SERVICE}=${2:SERVICE} # recommended=${2:SERVICE} | type=string | prompt=Enter the name of the application, it will be used for the website. For example, https://app.subdomain.example.com | immutable=false",
            "",
            "IP_${1:SS_SERVICE}=172.16.0.${3:IP} # recommended=172.16.0.${3:IP} | type=ip | immutable=true",
            "",
            "CPU_MIN_${1:SS_SERVICE}=0.25 # recommended=0.25 | type=number | prompt=Enter the minimum CPU allocation for the service (in cores) | immutable=true",
            "CPU_MAX_${1:SS_SERVICE}=1 # recommended=1 | type=number | prompt=Enter the maximum CPU allocation for the service (in cores) | immutable=false",
            "",
            "RAM_MIN_${1:SS_SERVICE}=6M # recommended=6M | type=string | prompt=Enter the minimum RAM allocation for the service (in megabytes or gigabytes, e.g., 512M or 1G) | immutable=true",
            "RAM_MAX_${1:SS_SERVICE}=128M # recommended=128M | type=string | prompt=Enter the maximum RAM allocation for the service (in megabytes or gigabytes, e.g., 512M or 1G) | immutable=false",
            "",
            "PORT_${1:SS_SERVICE}_EXTERNAL=${4:EXTERNAL_PORT} # recommended=${4:EXTERNAL_PORT} | type=port | prompt=Port exposed on the host machine | immutable=true",
            "PORT_${1:SS_SERVICE}_INTERNAL=${5:INTERNAL_PORT} # recommended=${5:INTERNAL_PORT} | type=port | prompt=Port the service listens on inside the container | immutable=true",
            "",
            "${1:SS_SERVICE}_PORT_CONFIG=traefik # recommended=traefik | type=string | prompt=Select on which network interfaces the service should be exposed | choices=[traefik (description=Only expose through traefik, default=true), all (description=Bind to all interfaces on the host, allowing access through both the host IP and traefik), localhost (description=Expose port to localhost, only accesible from this computer and not any other computers on the network and through traefik), tailscale (description=Bind  to the Tailscale IP only, restricting access to devices connected through Tailscale and through traefik)] | immutable=false",
            ""
        ]
    }
}