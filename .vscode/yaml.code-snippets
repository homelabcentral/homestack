{
  "Add a service": {
    "scope": "yaml,dockercompose",
    "prefix": "add-service",
    "description": "Docker compose service template",
    "body": [
      "name: \\${STACK_${1:OT_OMNI_TOOLS}:-${2:omni-tools}}",
      "services:",
      "  ${2}:",
      "    image: \\${DOCKER_IMAGE_${1}:-}",
      "    container_name: \\${CONTAINER_NAME_${1}:-${2}}",
      "    hostname: \\${HOST_NAME_${1}:-${2}}",
      "    restart: \\${RESTART_${1}:-unless-stopped}",
      "    networks:",
      "      traefiknet:",
      "        ipv4_address: \\${IP_${1}:-172.16.0.14}",
      "    deploy:",
      "      resources:",
      "        limits:",
      "          cpus: \\${CPU_MAX_${1}}",
      "          memory: \\${RAM_MAX_${1}}",
      "        reservations:",
      "          cpus: \\${CPU_MIN_${1}:-0.05}",
      "          memory: \\${RAM_MIN_${1}:-6M}",
      "    env_file:",
      "      - .env",
      "      - ../00.env/host.env",
      "      - ../00.env/network.env",
      "    ports:",
      "      - \\${IP_TAILSCALE}:\\${PORT_${1}_EXTERNAL}:\\${PORT_${1}_INTERNAL}",
      "    labels:",
      "      - \"traefik.enable=true\"",
      "      - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}.entrypoints=http\"",
      "      - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}.rule=Host(`\\${APP_NAME_${1}:-${2}}.\\${HOST_NAME}.\\${DOMAIN}`)\"",
      "      - \"traefik.http.middlewares.\\${APP_NAME_${1}:-${2}}-https-redirect.redirectscheme.scheme=https\"",
      "      - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}.middlewares=\\${APP_NAME_${1}:-${2}}-https-redirect\"",
      "      - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.entrypoints=https\"",
      "      - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.rule=Host(`\\${APP_NAME_${1}:-${2}}.\\${HOST_NAME}.\\${DOMAIN}`)\"",
      "      - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.tls=true\"",
      "      - \"traefik.http.routers.\\${APP_NAME_${1}:-${2}}-secure.service=\\${APP_NAME_${1}:-${2}}\"",
      "      - \"traefik.http.services.\\${APP_NAME_${1}:-${2}}.loadbalancer.server.port=\\${PORT_${1}_INTERNAL}\"",
      "      - \"traefik.docker.network=\\${DOCKER_NETWORK:-traefiknet}\"",
      "",
      "networks:",
      "  traefiknet:",
      "    name: \\${DOCKER_NETWORK:-traefiknet}",
      "    external: true",
      "$0"
    ]
  },

  "Services Ports Block": {
    "scope": "yaml,dockercompose",
    "prefix": "services-ports",
    "description": "Insert services ports configuration with traefik, localhost, and tailscale",
    "body": [
      "services:",
      "  # This makes the homepage available only through traefik",
      "  traefik: {}",
      "",
      "  # This makes the homepage available on all network interfaces of the host, including the host IP and through traefik (if enabled)",
      "  localhost:",
      "    ports:",
      "      - \\${PORT_${1:SS_SERVICE}_EXTERNAL:-${2:3006}}:\\${PORT_${1:SS_SERVICE}_INTERNAL:-${3:80}}",
      "",
      "  # This makes the homepage available only on the Tailscale IP address of the host, allowing access over Tailscale VPN and through traefik (if enabled)",
      "  tailscale:",
      "    ports:",
      "      - \\${IP_TAILSCALE}:\\${PORT_${1:SS_SERVICE}_EXTERNAL:-${2:3006}}:\\${PORT_${1:SS_SERVICE}_INTERNAL:-${3:80}}"
    ]
  },

  "Service Extends Block": {
    "scope": "yaml,dockercompose",
    "prefix": "service-extends",
    "description": "Insert extends configuration for ports.yml",
    "body": [
      "extends:",
      "      file: ports.yml # Change the ports config if you want to expose this container on different interfaces or ports. By default it is set to only be exposed through traefik, but you can change it to be exposed on localhost (all interfaces) or tailscale IP only. If you change it to localhost or tailscale, it will also be exposed through traefik if you have it.",
      "      service: \\${${1:SS_SERVICE}_PORT_CONFIG:-traefik} # traefik = only through traefik, localhost = bind to all interfaces on the host & traefik (if you have it), tailscale = bind to tailscale IP only & traefik (if you have it)"
    ]
  }
}
